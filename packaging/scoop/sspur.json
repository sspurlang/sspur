            "hash": "@SHA_X86_64_PC_WINDOWS_MSVC@",
            "extract_dir": "sspur-v@VERSION@-x86_64-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/sspurlang/sspur/releases/download/v@VERSION@/sspur-v@VERSION@-aarch64-pc-windows-msvc.zip",
            "hash": "@SHA_AARCH64_PC_WINDOWS_MSVC@",
            "extract_dir": "sspur-v@VERSION@-aarch64-pc-windows-msvc"
        }
    },
    "bin": "sspur.exe",
