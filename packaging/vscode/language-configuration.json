{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "wordPattern": "\\?[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*|-?\\d[\\d_]*(?:\\.\\d[\\d_]*)?",
  "indentationRules": {
    "increaseIndentPattern": "^(?!\\s*//).*(?:\\bdo|\\bthen|\\belse|=>|=|[(\\[{])\\s*(?://.*)?$|^\\s*(?:pub\\s+)?(?:trait|impl|svc)\\b.*$|^\\s*(?:pub\\s+)?effect\\s+\\w+(?:\\[[^\\]]*\\])?\\s*$|^[^|]*\\b(?:match|catch|handle)\\b[^|]*$",
    "decreaseIndentPattern": "^\\s*=(?!=|>)"
  },
  "folding": {
    "offSide": true
  },
  "onEnterRules": [
    {
      "beforeText": "^(?!\\s*//)\\s*(?:[^()\\[\\]{}\"]|\"(?:\\\\.|[^\"\\\\])*\"|\\((?:[^()]|\\([^()]*\\))*\\)|\\[(?:[^\\[\\]]|\\[[^\\[\\]]*\\])*\\]|\\{(?:[^{}]|\\{[^{}]*\\})*\\})*[)\\]}]*,\\s*(?://.*)?$",
      "action": {
        "indent": "none"
      }
    },
    {
      "beforeText": "^(?!\\s*//)\\s*(?:\\.[A-Za-z_]|(?:and|or|is)\\b|[-+*/%<>]|==|!=|&&).*(?:\\*\\*|==|!=|<=|>=|:=|&&|\\|\\||->|[-+*/%<,]|(?<!=)>|(?:^|[^\\w])(?:and|or|is|with))\\s*(?://.*)?$",
      "action": {
        "indent": "none"
      }
    },
    {
      "previousLineText": "^(?!\\s*//).*(?:\\*\\*|==|!=|<=|>=|:=|&&|\\|\\||->|[-+*/%<,]|(?<!=)>|(?:^|[^\\w])(?:and|or|is|with))\\s*(?://.*)?$",
      "beforeText": "^(?!\\s*//).*(?:\\*\\*|==|!=|<=|>=|:=|&&|\\|\\||->|[-+*/%<,]|(?<!=)>|(?:^|[^\\w])(?:and|or|is|with))\\s*(?://.*)?$",
      "action": {
        "indent": "none"
      }
    },
    {
      "beforeText": "^(?!\\s*//).*(?:\\*\\*|==|!=|<=|>=|:=|&&|\\|\\||->|[-+*/%<,]|(?<!=)>|(?:^|[^\\w])(?:and|or|is|with))\\s*(?://.*)?$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "previousLineText": "^(?!\\s*//).*(?:\\*\\*|==|!=|<=|>=|:=|&&|\\|\\||->|[-+*/%<,]|(?<!=)>|(?:^|[^\\w])(?:and|or|is|with))\\s*(?://.*)?$",
      "beforeText": "^(?!\\s*//)(?!\\s*(?:\\.[A-Za-z_]|(?:and|or|is)\\b|[-+*/%<>]|==|!=|&&))(?!.*(?:\\bdo|\\bthen|\\belse|=>|=|[(\\[{])\\s*(?://.*)?$).*\\S",
      "action": {
        "indent": "outdent"
      }
    }
  ]
}
