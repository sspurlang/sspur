      "file-types": ["ssp"],
      "injection-regex": "^(sspur|ssp)$",
      "highlights": ["../languages/sspur/highlights.scm"]
    }
  ],
  "metadata": {
    "version": "0.15.0",
    "license": "MIT OR Apache-2.0",
    "description": "SSPUR grammar for tree-sitter",
    "authors": [{ "name": "Utkarsha Vardhana" }],
    "links": { "repository": "https://github.com/sspurlang/sspur" }
  },
  "bindings": { "c": false, "go": false, "node": false, "python": false, "rust": false, "swift": false }
}
