// F64 order and conversions: numeric order where IEEE has one, NaN equal to itself and above +inf,
// -0.0 equal to 0.0; conversions to Int that can't be exact trap, and checked_* give none

fn neg_zero(x: F64) -> F64
= -1.0 * x

fn non_negative(x: F64 where _ >= 0.0) -> F64
= x + 1.0

fn checked(x: F64) -> List[Opt[Int]]
= [x.checked_round, x.checked_floor, x.checked_ceil, x.checked_trunc]

fn not_a_number() -> F64
= nan()

test nan_equals_itself = not_a_number() == not_a_number()
test nan_above_inf = [not_a_number(), inf(), 1.0, -inf()].sort.last.map(_.is_nan) == some(true)
test nan_not_less = not (not_a_number() < 1.0) and 1.0 < not_a_number()
test zeros_equal = neg_zero(0.0) == 0.0 and not (neg_zero(0.0) < 0.0) and neg_zero(0.0) >= 0.0
test zero_refinement = non_negative(neg_zero(0.0)) == 1.0
test zeros_one_key = empty_map().put(neg_zero(0.0), 1).put(0.0, 2).len == 1
test zeros_unique = [0.0, neg_zero(0.0)].unique.len == 1
test zeros_sort_stable = "{[0.0, neg_zero(0.0)].sort}" == "[0.0, -0.0]"
test zero_keeps_sign = "{neg_zero(0.0)}" == "-0.0" and (1.0 / neg_zero(0.0)) < 0.0
test checked_in_range = checked(2.5) == [some(3), some(2), some(3), some(2)] and checked(-2.5) == [some(-3), some(-3), some(-2), some(-2)]
test checked_edges = checked(-9223372036854775808.0) == [some(-9223372036854775807 - 1), some(-9223372036854775807 - 1), some(-9223372036854775807 - 1), some(-9223372036854775807 - 1)]
test checked_out = checked(9223372036854775808.0) == [none, none, none, none] and checked(not_a_number()) == [none, none, none, none] and checked(-inf()) == [none, none, none, none]
test plain_in_range = 2.5.round == 3 and 2.7.floor == 2 and (-2.2).ceil == -2 and (-2.7).trunc == -2 and 9.2e18.round == 9200000000000000000
