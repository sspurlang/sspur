kernel fn saxpy(a: F32, x: &[F32], y: &mut [F32]) @grid(y.len, 256)
= y[gid] := a * x[gid] + y[gid]

kernel fn bump(m: &mut [I32]) @grid(m.len, 64)
= m[gid] := m[gid] + 1

kernel fn half(x: &[F32], y: &mut [F32]) @grid(y.len, 64)
= y[gid] := x[gid] * 0.5

kernel fn scale(y: &mut [F32], s: F32) @grid(y.len, 32)
= y[gid] := y[gid] * s

fn partial_rerun() -> List[F64] ! dev
= do
  y = dev_f32((0..100).map(i => if i % 7 == 0 then 1.0e-30 else i.to_f64))
  scale(&mut y, 1.0e-10)
  gpu_sync()
  scale(&mut y, 3.0)
  y.to_list

fn steps(n: Int, k: Int) -> List[F64] ! dev
= do
  x = dev_f32((0..n).map(i => i.to_f64))
  y = dev_f32((0..n).map(i => 1.0))
  for r in 0..k
    saxpy(0.5, &x, &mut y)
  y.to_list

fn mixed(n: Int) -> List[F64] ! dev
= do
  x = dev_f32((0..n).map(i => i.to_f64 * 3.0))
  var ys = (0..n).map(i => 0.0)
  half(&x, &mut ys)
  y = dev_f32(ys)
  half(&x, &mut y)
  ys + y.to_list

fn aliased() -> Int ! dev
= do
  b = dev_f32([1.0, 2.0])
  c = b
  half(&b, &mut c)
  c.len

fn shared(n: Int) -> List[Int] ! dev
= do
  m = dev_i32((0..n).map(i => i * 2))
  alias = m
  bump(&mut m)
  bump(&mut alias)
  m.to_list

fn badbuf() -> Int ! dev
= do
  b = dev_i32([1, 5000000000])
  b.len

fn wrap(n: Int) -> List[Int] ! dev
= do
  m = dev_i32((0..n).map(i => 2147483646 + i % 2))
  bump(&mut m)
  bump(&mut m)
  m.to_list

fn both() -> Bool ! dev
= do
  (a, b) = par(steps(2000, 3), steps(3000, 2))
  a == steps(2000, 3) and b == steps(3000, 2)

fn ranged(n: Int, bad: Int, div: Int) -> List[Int] ! dev
= do
  m = dev_i32((0..n).map(i => if i == bad then 3000000000 + i else 100 / (i - div)))
  bump(&mut m)
  m.to_list

fn ranged_sum(n: Int) -> F64 ! dev
= do
  y = dev_f32((0..n).map(i => (i % 9).to_f64 * 0.25 - 1.0))
  h = dev_i32((3..n).map(i => i * i))
  y.to_list.sum + h.to_list.sum.to_f64 + dev_f32((0..0).map(i => 1.0)).to_list.sum

test ranged_ok = ranged(6, -1, 10) == [-9, -10, -11, -13, -15, -19] and ranged_sum(1000) == ranged_sum(1000) and ranged_sum(1000) > 0.0
test ranged_bad_trap = ranged(9, 2, 20).len == 9
test ranged_late_div_trap = ranged(9, 2, 6).len == 9
test par_ok = both()
test steps_ok = steps(1000, 4)[999] == 1.0 + 4.0 * 0.5 * 999.0
test mixed_ok = mixed(4) == [0.0, 1.5, 3.0, 4.5, 0.0, 1.5, 3.0, 4.5]
test shared_ok = shared(3) == [2, 4, 6]
test alias_trap = aliased() == 2
test badbuf_trap = badbuf() == 2
test wrap_trap = wrap(4).len == 4

fn main() ! dev, log
= do
  log("{steps(100000, 10).sum}")
  log("{mixed(5)}")
  log("{shared(4)}")
  log("{partial_rerun()}")
