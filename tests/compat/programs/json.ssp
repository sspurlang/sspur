// std_json

type Sku = new Str

type Line = {sku: Sku, qty: Int, note: Opt[Str]}

type Status = Draft | Paid{at: Int} | Shipped{at: Int, carrier: Str}

type Order = {id: Int, lines: List[Line], status: Status, tags: Set[Str], meta: Map[Str, F64]}

fn sample() -> Order
= Order{
  id: 7,
  lines: [
    Line{sku: Sku("a-1"), qty: 2, note: none},
    Line{sku: Sku("b\"2"), qty: 1, note: some("gift\nwrap")},
  ],
  status: Shipped{at: 1700, carrier: "ups"},
  tags: ["x", "a"].to_set,
  meta: empty_map().put("w", 1.5).put("h", 2.0),
}

fn encode_order(o: Order) -> Str
= json.encode(o)

fn round_trip(o: Order) -> Bool
= json.decode[Order](json.encode(o)) == ok(o)

fn decode_order(s: Str) -> Res[Order, Str]
= json.decode[Order](s)

fn statuses() -> Str
= json.encode([Draft, Paid{at: 3}])

fn pairs() -> Str
= json.encode(empty_map().put(2, "two").put(1, "one"))

fn tuples(s: Str) -> Res[List[(Int, Bool)], Str]
= json.decode[List[(Int, Bool)]](s)

fn ints(s: Str) -> Res[Map[Int, Str], Str]
= json.decode[Map[Int, Str]](s)

fn describe(st: Status) -> Str
= match st
| Draft => "draft"
| Paid{at} => "paid {at}"
| Shipped{carrier} => "shipped by {carrier}"

fn status_of(s: Str) -> Str
= match json.decode[Status](s)
| ok(st) => describe(st)
| err(e) => e

fn floats() -> Str
= json.encode([0.1, -0.0, 1e21, 2.5e-8, 1.0 / 0.0])

fn unicode(s: Str) -> Res[Str, Str]
= json.decode[Str](s)

fn heap_json() -> Str
= json.encode(([5, 1, 3].to_heap, [3, 1].to_set, str_buf().add("ab")))

test enc = encode_order(sample()) ==
  "\{\"id\":7,\"lines\":[\{\"sku\":\"a-1\",\"qty\":2,\"note\":null},\{\"sku\":\"b\\\"2\",\"qty\":1,\"note\":\"gift\\nwrap\"}],\"status\":\{\"tag\":\"Shipped\",\"at\":1700,\"carrier\":\"ups\"},\"tags\":[\"a\",\"x\"],\"meta\":\{\"h\":2.0,\"w\":1.5}}"

test trip = round_trip(sample())

test missing_opt = decode_order(
  "\{\"id\": 1, \"lines\": [\{\"sku\": \"z\", \"qty\": 3}], \"status\": \"Draft\", \"tags\": [], \"meta\": \{}}",
).map(_.lines[0].note) == ok(none)

test wrong_type = decode_order(
  "\{\"id\": 1, \"lines\": [\{\"sku\": \"z\", \"qty\": \"3\"}], \"status\": \"Draft\", \"tags\": [], \"meta\": \{}}",
) == err("lines[0].qty: expected Int, found a string")

test missing_field = decode_order("\{\"lines\": []}") == err("id: expected Int, found nothing")

test bad_json = decode_order("\{\"id\": 1,}") == err("invalid JSON")

test bad_tag = status_of("\{\"tag\": \"Lost\"}") ==
  "value: expected one of Draft, Paid, Shipped, found a string"

test tags = [
  status_of("\"Draft\""),
  status_of("\{\"tag\": \"Paid\", \"at\": 9}"),
  status_of("\{\"tag\":\"Shipped\",\"at\":1,\"carrier\":\"dhl\"}"),
] == ["draft", "paid 9", "shipped by dhl"]

test sums = statuses() == "[\"Draft\",\{\"tag\":\"Paid\",\"at\":3}]"

test int_keys = pairs() == "[[1,\"one\"],[2,\"two\"]]" and
  ints(pairs()).map(_.get(2)) == ok(some("two"))

test pair_shape = ints("[[1, \"a\", 3]]") == err("[0]: expected [key, value], found an array")

test tuple_list = tuples(" [ [1, true], [-2, false] ] ") == ok([(1, true), (-2, false)]) and
  tuples("[[1]]") == err("[0]: expected (Int, Bool), found an array")

test float_forms = floats() == "[0.1,-0.0,1e21,2.5e-8,null]"

test escapes = unicode("\"\\u00e9\\ud83d\\ude00\\t\"") == ok("é😀\t") and
  unicode("\"\\ud800\"") == err("invalid JSON")

test big_int = json.decode[Int]("9223372036854775808") == err("value: expected Int, found a number")

test collections = heap_json() == "[[1,3,5],[1,3],\"ab\"]"

type Omm = {OBJECT_NAME: Str, MEAN_MOTION: F64}

fn omm_names(s: Str) -> Res[List[Str], Str]
= json.decode[List[Omm]](s).map(gs => gs.map(g => "{g.OBJECT_NAME} {g.MEAN_MOTION * 2.0}"))

test upper_fields = omm_names(
  "[\{\"OBJECT_NAME\": \"ISS \\\"Z\\\" \\u00e9\", \"MEAN_MOTION\": 15.5}, \{\"OBJECT_NAME\": \"\", \"MEAN_MOTION\": 1.0}]",
) == ok(["ISS \"Z\" é 31.0", " 2.0"])
