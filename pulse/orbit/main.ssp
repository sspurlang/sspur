// Satellites in orbit: CelesTrak's active satellites (OMM JSON), checked, grouped by operator,
// and written as compact orbital elements that the launches page propagates with SGP4 in the browser.

use pulse.{Ctx, Got, Headline, esc, thousands, cap}

type Gp = {OBJECT_NAME: Str, NORAD_CAT_ID: Int, EPOCH: Str, MEAN_MOTION: F64, ECCENTRICITY: F64, INCLINATION: F64, RA_OF_ASC_NODE: F64, ARG_OF_PERICENTER: F64, MEAN_ANOMALY: F64, BSTAR: F64}
type Gps = List[Gp]

type Sat = {id: Int, name: Str, group: Int, yy: Int, day: F64, bstar: F64, inc: F64, raan: F64, ecc: F64, argp: F64, ma: F64, mm: F64}
type State = {updated: Str, epoch: Str, sats: List[Sat]}
type Part = {file: Str, count: Int}
type GroupOut = {key: Str, name: Str, color: Str, count: Int, leo: Int, meo: Int, geo: Int, parts: List[Part]}
type Index = {updated: Str, epoch: Str, total: Int, leo: Int, meo: Int, geo: Int, groups: List[GroupOut]}

type Inclination = F64 where _ >= 0.0 and _ <= 180.0
type MeanMotion = F64 where _ > 0.0 and _ < 20.0

// Operators and constellations, in display order: key, name, colour on the dark globe.
fn groups() -> List[(Str, Str, Str)]
= [("starlink", "SpaceX Starlink", "#5b9bff"), ("oneweb", "OneWeb", "#2fd2c4"), ("kuiper", "Amazon Kuiper", "#ffb020"), ("china", "Qianfan and Guowang", "#ff6b81"), ("iridium", "Iridium", "#b794ff"), ("planet", "Planet and Spire", "#7bdc65"), ("gps", "GPS", "#ff8a3d"), ("glonass", "GLONASS", "#e36bff"), ("galileo", "Galileo", "#55d8ff"), ("beidou", "BeiDou", "#ff5050"), ("isro", "NavIC and ISRO", "#ffa31a"), ("crewed", "ISS and Tiangong", "#ffffff"), ("weather", "Weather", "#a8ecff"), ("geo", "Geostationary comms", "#ffd84d"), ("other", "Other", "#8f9bb3")]

fn starts(n: Str, ps: List[Str]) -> Bool
= ps.any(p => n.starts_with(p))

pub fn altitude(mm: F64) -> F64
= do
  n = mm * 2.0 * pi() / 86400.0
  (398600.4418 / (n * n)).cbrt - 6378.137

fn band(mm: F64) -> Int
= do
  h = altitude(mm)
  if h < 2000.0 then 0 else if h > 35000.0 and h < 36600.0 then 2 else 1

pub fn classify(n: Str, mm: F64, inc: F64, ecc: F64) -> Int
= if n.starts_with("STARLINK") then 0
  else if n.starts_with("ONEWEB") then 1
  else if n.starts_with("KUIPER") then 2
  else if starts(n, ["QIANFAN", "HULIANWANG"]) then 3
  else if n.starts_with("IRIDIUM") then 4
  else if starts(n, ["FLOCK", "SKYSAT", "PELICAN", "LEMUR", "TANAGER"]) then 5
  else if starts(n, ["NAVSTAR", "GPS "]) then 6
  else if n.starts_with("COSMOS") and band(mm) == 1 and inc > 63.0 and inc < 67.0 then 7
  else if n.contains("GALILEO") then 8
  else if n.starts_with("BEIDOU") then 9
  else if starts(n, ["IRNSS", "NVS-", "GSAT-", "GSAT ", "CARTOSAT", "RISAT", "EOS-", "OCEANSAT", "RESOURCESAT", "ASTROSAT", "INSAT", "HYSIS", "EMISAT", "SCATSAT", "MICROSAT", "AMAZONIA"]) then 10
  else if starts(n, ["ISS (", "CSS (", "TIANGONG"]) then 11
  else if starts(n, ["NOAA", "METEOSAT", "METOP", "HIMAWARI", "GOES", "FENGYUN", "FY-", "ELEKTRO", "METEOR-M", "GEO-KOMPSAT", "INSAT-3D"]) then 12
  else if band(mm) == 2 and ecc < 0.05 then 13
  else 14

test classes = classify("STARLINK-1008", 15.06, 53.0, 0.0001) == 0 and classify("COSMOS 2525", 2.13, 64.8, 0.001) == 7 and classify("COSMOS 2525", 15.0, 97.0, 0.001) == 14 and classify("GSAT0101 (GALILEO-PFM)", 1.7, 56.0, 0.0002) == 8 and classify("IRNSS-1B", 1.0027, 29.0, 0.002) == 10 and classify("INTELSAT 906 (IS-906)", 1.0027, 0.02, 0.0003) == 13 and classify("ISS (ZARYA)", 15.5, 51.6, 0.0004) == 11
test altitudes = altitude(15.5).round > 400 and altitude(15.5).round < 440 and band(1.0027) == 2 and band(2.0) == 1

// "2026-10-13T09:57:23.699232" as the two-digit year and day of the year with its fraction.
fn epoch_parts(e: Str) -> Opt[(Int, F64)]
= if e.split("T") is [d, t] and parse_time(d) is some(day) and t.split(":") is [h, m, s] and h.to_int is some(hh) and m.to_int is some(mi) and s.to_f64 is some(ss) then some((day.year % 100, day.yday.to_f64 + (hh.to_f64 * 3600.0 + mi.to_f64 * 60.0 + ss) / 86400.0)) else none

test epochs = epoch_parts("2026-01-01T12:00:00.000000") == some((26, 1.5)) and epoch_parts("bad").is_none

fn fresh(e: Str, now: Time) -> Bool
= match parse_time(e.split(".").first.or(e) + "Z")
  | some(t) => now.unix_ms - t.unix_ms < 45 * 86400000 and t.unix_ms - now.unix_ms < 86400000
  | none => false

fn sat(g: Gp, now: Time) -> Opt[Sat]
= do
  Gp{OBJECT_NAME: name, NORAD_CAT_ID: id, EPOCH: epoch, MEAN_MOTION: mm, ECCENTRICITY: ecc, INCLINATION: inc, RA_OF_ASC_NODE: raan, ARG_OF_PERICENTER: argp, MEAN_ANOMALY: ma, BSTAR: bstar} = g
  if epoch_parts(epoch) is some((yy, day)) and fresh(epoch, now) and checked(inc, mm) and ecc >= 0.0 and ecc < 1.0 then some(Sat{id, name: name.trim, group: classify(name, mm, inc, ecc), yy, day, bstar, inc, raan, ecc, argp, ma, mm}) else none

fn in_range(inc: F64, mm: F64) -> Bool
= inc >= 0.0 and inc <= 180.0 and mm > 0.0 and mm < 20.0

fn checked(inc: F64, mm: F64) -> Bool
= in_range(inc, mm) and ranged(inc, mm)

fn ranged(i: Inclination, m: MeanMotion) -> Bool
= i <= 180.0 and m > 0.0

fn parse(s: Str, now: Time) -> Res[List[Sat], Str]
= match json.decode[Gps](s)
  | err(e) => err("bad GP data: {e}")
  | ok(gs) => do
    ss = gs.map(g => sat(g, now)).filter(_.is_some).map(_.get)
    if ss.len < 20 then err("too few satellites") else if ss.len * 10 < gs.len * 9 then err("too many bad element sets: {gs.len - ss.len} of {gs.len}") else ok(ss)

fn fetch(cx: Ctx) -> Res[State, Str] ! proc, fs, time, log
= do
  ok(ss) = pulse.get(cx, "active.json", "https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=json", []).map(s => parse(s, pulse.stamp(cx))).or(err("CelesTrak fetch failed")) else err("CelesTrak unavailable")
  newest = ss.map(s => s.yy.to_f64 * 1000.0 + s.day).max.or(0.0)
  ok(State{updated: pulse.stamp(cx).iso, epoch: "{newest.fmt(3)}", sats: ss})

fn decode_state(s: Str) -> Opt[State]
= match json.decode[State](s)
  | ok(st) if not st.sats.is_empty => some(st)
  | _ => none

fn load(cx: Ctx) -> Opt[State] ! fs
= pulse.read(pulse.state_path(cx, "state.json")).map(decode_state).or(none)

// Output: one compact array per satellite, only what SGP4 needs, trimmed to useful precision.
fn row(s: Sat) -> Str
= "[{s.id},{json.encode(s.name)},{s.yy},{s.day.fmt(6)},{s.bstar.format(".3e")},{s.inc.fmt(3)},{s.raan.fmt(3)},{(s.ecc * 10000000.0).round},{s.argp.fmt(3)},{s.ma.fmt(3)},{s.mm.fmt(7)}]"

test rows = row(Sat{id: 1, name: "A \"B\"", group: 0, yy: 26, day: 286.5, bstar: 0.000123, inc: 53.05, raan: 1.0, ecc: 0.0001, argp: 2.0, ma: 3.0, mm: 15.06}) == "[1,\"A \\\"B\\\"\",26,286.500000,1.230e-04,53.050,1.000,1000,2.000,3.000,15.0600000]"

fn parts_of(key: Str, ss: List[Sat]) -> List[(Str, List[Sat])]
= if key == "starlink" then (0..4).map(i => ("{key}-{i}", ss.enumerate.filter(p => p.0 % 4 == i).map(_.1))) else [("{key}-0", ss)]

fn publish(cx: Ctx, st: State) -> Index ! fs, log
  pre st.sats.all(s => s.inc >= 0.0 and s.inc <= 180.0 and s.mm > 0.0)
= do
  gs = groups().enumerate.map(p => do
    (i, (key, name, color)) = p
    ss = st.sats.filter(_.group == i)
    parts = parts_of(key, ss).filter(q => not q.1.is_empty)
    for (file, xs) in parts
      pulse.publish(cx, "sats/{file}.json", "\{\"g\":\"{key}\",\"s\":[{xs.map(row).join(",")}]}\n")
    GroupOut{key, name, color, count: ss.len, leo: ss.filter(s => band(s.mm) == 0).len, meo: ss.filter(s => band(s.mm) == 1).len, geo: ss.filter(s => band(s.mm) == 2).len, parts: parts.map(q => Part{file: q.0, count: q.1.len})}).filter(_.count > 0)
  idx = Index{updated: st.updated, epoch: st.epoch, total: st.sats.len, leo: gs.map(_.leo).sum, meo: gs.map(_.meo).sum, geo: gs.map(_.geo).sum, groups: gs}
  pulse.publish(cx, "api/orbit.json", json.encode(idx))
  idx

fn main() -> Unit ! log, fs, proc, env, time
= do
  cx = pulse.ctx("orbit")
  prev = load(cx)
  fresh = if pulse.due(cx, prev.map(_.updated).or(""), 300) then fetch(cx) else err("skip")
  match pulse.settle(fresh, prev, () => fetch(pulse.seed_ctx(cx)))
  | none => log("orbit: no data at all")
  | some(g) => do
    if not g.stale and fresh.is_ok then pulse.save(pulse.state_path(cx, "state.json"), json.encode(g.value))
    idx = publish(cx, g.value)
    log("orbit: {idx.total} satellites in {idx.groups.len} groups{if g.stale then " (stale)" else ""}")

fn fixture() -> Str ! fs
= pulse.read("../fixtures/orbit/active.json").or("")

test parses_fixture = parse(fixture(), parse_time("2026-10-14T03:00:00Z").get) is ok(ss) and ss.len > 100 and ss.all(s => s.inc >= 0.0 and s.inc <= 180.0)
test rejects_stale_elements = parse(fixture(), parse_time("2027-06-01T00:00:00Z").get).is_err
test rejects_garbage = parse("[]", time_ms(0)).is_err and parse("nope", time_ms(0)).is_err
test groups_found = parse(fixture(), parse_time("2026-10-14T03:00:00Z").get) is ok(ss) and [0, 1, 2, 4, 6, 9, 10, 11, 13].all(g => ss.any(_.group == g))
