// Fastest rising GitHub repos: two search calls per run, and our own snapshots
// of their stars, so velocity is stars actually gained between runs.

use pulse.{Ctx, Got, Group, View, Range, Chart, Series, Item, Headline, Page, esc, safe_url, thousands, compact, plural, ago, short_date, cap, clip}

type RawRepo = {full_name: Str, html_url: Str, description: Opt[Str], language: Opt[Str], stargazers_count: Int, forks_count: Opt[Int], created_at: Str}
type Search = {items: List[RawRepo]}

type Repo = {name: Str, url: Str, desc: Str, lang: Str, stars: Int, forks: Int, created: Str}
type Snap = {t: Str, stars: Map[Str, Int]}
type State = {updated: Str, repos: List[Repo], snaps: List[Snap]}
type Rank = {repo: Repo, vel: F64, est: Bool, gained: Int}
type Api = {meta: pulse.Meta, rising: List[Rank], snapshots: Int}

type Stars = Int where _ >= 0 and _ < 100000000

fn stars_ok(n: Stars) -> Bool
= n >= 0

fn repo(r: RawRepo) -> Repo
= Repo{name: r.full_name, url: r.html_url, desc: pulse.squash(r.description.or("")), lang: r.language.or("Other"), stars: r.stargazers_count, forks: r.forks_count.or(0), created: r.created_at}

fn valid(r: Repo) -> Bool
= r.name.contains("/") and r.url.starts_with("https://github.com/") and r.stars >= 0 and r.stars < 100000000 and parse_time(r.created).is_some

fn parse(s: Str) -> Res[List[Repo], Str]
= match json.decode[Search](s)
  | err(e) => err("bad search response: {e}")
  | ok(sr) => do
    rs = sr.items.map(repo).filter(valid)
    if rs.len * 10 < sr.items.len * 9 then err("too many malformed repos") else ok(rs)

fn search_url(since: Str, n: Int) -> Str
= "https://api.github.com/search/repositories?q=created:%3E{since}&sort=stars&order=desc&per_page={n}"

fn headers(token: Str) -> List[Str]
= ["Accept: application/vnd.github+json", "X-GitHub-Api-Version: 2022-11-28"] + (if token == "" then [] else ["Authorization: Bearer {token}"])

// The newest snapshot at least two hours older than t, so velocity is not noise.
fn prev_snap(snaps: List[Snap], t: Time) -> Opt[Snap]
= snaps.filter(s => t.unix_ms - pulse.day_time(s.t).unix_ms >= 7200000).last

fn age_days(r: Repo, t: Time) -> F64
= max(0.5, (t.unix_ms - pulse.day_time(r.created).unix_ms).to_f64 / 86400000.0)

fn rank(r: Repo, t: Time, prev: Opt[Snap]) -> Rank
= if prev is some(p) and p.stars.get(r.name) is some(old) then do
    hours = max(1.0, (t.unix_ms - pulse.day_time(p.t).unix_ms).to_f64 / 3600000.0)
    Rank{repo: r, vel: (r.stars - old).to_f64 / hours * 24.0, est: false, gained: r.stars - old}
  else Rank{repo: r, vel: r.stars.to_f64 / age_days(r, t), est: true, gained: r.stars}

fn ranking(s: State) -> List[Rank]
= do
  t = pulse.day_time(s.updated)
  prev = prev_snap(s.snaps, t)
  s.repos.map(r => rank(r, t, prev)).sort_by(k => (-k.vel, k.repo.name))

// Keep at most 120 snapshots (30 days at four runs a day), each only for the repos worth drawing.
fn add_snap(snaps: List[Snap], t: Str, repos: List[Repo], keep: List[Str]) -> List[Snap]
= do
  ks = keep.to_set
  now = Snap{t, stars: repos.filter(r => ks.has(r.name)).fold(empty_map(), (m, r) => m.put(r.name, r.stars))}
  cap(snaps.filter(_.t != t).map(s => prune(s, ks)) + [now], 120)

fn prune(s: Snap, ks: Set[Str]) -> Snap
= Snap{t: s.t, stars: s.stars.items.filter(p => ks.has(p.0)).fold(empty_map(), (m, p) => m.put(p.0, p.1))}

fn fetch(cx: Ctx, prev: Opt[State], token: Str) -> Res[State, Str] ! proc, fs, time, log
= do
  week = pulse.day(cx.now.add(days(-7)))
  month = pulse.day(cx.now.add(days(-30)))
  a = pulse.get(cx, "week.json", search_url(week, 50), headers(token)).map(parse).or(err("week search failed"))
  b = pulse.get(cx, "month.json", search_url(month, 100), headers(token)).map(parse).or(err("month search failed"))
  if a.is_err and b.is_err then err("both searches failed") else do
    repos = pulse.uniq_by(a.or([]) + b.or([]), _.name)
    if repos.len < 10 then err("too few repos") else do
      t = pulse.stamp(cx).iso
      old = prev.map(_.snaps).or([])
      draft = State{updated: t, repos, snaps: old}
      keep = ranking(draft).take(60).map(_.repo.name)
      ok(State{updated: t, repos, snaps: add_snap(old, t, repos, keep)})

fn decode_state(s: Str) -> Opt[State]
= match json.decode[State](s)
  | ok(st) if not st.repos.is_empty => some(st)
  | _ => none

fn load(cx: Ctx) -> Opt[State] ! fs
= pulse.read(pulse.state_path(cx, "state.json")).map(decode_state).or(none)

// Rendering

fn slug(lang: Str) -> Str
= lang.lower.words.join("-")

fn short(name: Str) -> Str
= clip(name.split("/").last.or(name), 16)

fn series(s: State, name: Str) -> List[Opt[F64]]
= s.snaps.map(p => p.stars.get(name).map(_.to_f64))

fn vel_label(k: Rank) -> Str
= if k.vel >= 10.0 then thousands(k.vel.round) else k.vel.fmt(1)

fn row(s: State, i: Int, k: Rank, top: F64, langs: List[Str], now: Time) -> Str
= do
  r = k.repo
  tag = if langs.contains(r.lang) then slug(r.lang) else "other"
  w = if top <= 0.0 then 0.0 else min(1.0, k.vel / top)
  "<li class='row withsp' data-tags='all {tag}' data-kvel='{k.vel.fmt(2)}' data-kstars='{r.stars}' data-knew='{pulse.day_time(r.created).unix_ms / 1000}'><span class='rk'>{i + 1}</span><div class='main'><p class='t'><a href='{safe_url(r.url)}'>{esc(r.name)}</a></p>{if r.desc == "" then "" else "<p class='m'>{esc(clip(r.desc, 150))}</p>"}<p class='m'><span class='pill'>{esc(r.lang)}</span> {thousands(r.stars)} stars · created {ago(now, pulse.day_time(r.created))}</p><span class='bar' style='--w:{w.fmt(3)}'></span></div><span class='v'>+{vel_label(k)}<small>{if k.est then "stars a day, est." else "stars a day"}</small></span>{pulse.spark(series(s, r.name), "")}</li>"

fn gain_group(ks: List[Rank]) -> Group
= do
  top = ks.take(15)
  labels = top.map(k => short(k.repo.name))
  gain = Chart{kind: "hbar", labels, series: [Series{key: "vel", name: "Stars a day", color: 3, values: top.map(k => some(k.vel))}], unit: "stars a day", digits: 0}
  total = Chart{kind: "hbar", labels, series: [Series{key: "stars", name: "Total stars", color: 1, values: top.map(k => some(k.repo.stars.to_f64))}], unit: "stars", digits: 0}
  Group{id: "gain", views: [View{key: "vel", label: "Stars a day", chart: gain}, View{key: "total", label: "Total stars", chart: total}], ranges: [], view: "vel", range: ""}

fn curve_group(s: State, ks: List[Rank]) -> Group
= do
  labels = s.snaps.map(p => do
    t = pulse.day_time(p.t)
    "{short_date(t)} {pulse.hm(t)}")
  top = ks.filter(k => not k.est).take(5)
  c = Chart{kind: "line", labels, series: top.enumerate.map(p => Series{key: "r{p.0}", name: short(p.1.repo.name), color: p.0 + 1, values: series(s, p.1.repo.name)}), unit: "stars", digits: 0}
  Group{id: "curves", views: [View{key: "stars", label: "Stars", chart: c}], ranges: [Range{key: "24h", label: "24 hours", n: 5}, Range{key: "7d", label: "7 days", n: 29}, Range{key: "30d", label: "30 days", n: 120}], view: "stars", range: "7d"}

fn headline(ks: List[Rank]) -> Headline
= match ks.first
  | some(k) => Headline{value: "+{compact(k.vel)}", label: "stars a day for {k.repo.name}", detail: if k.repo.desc == "" then "The fastest rising new repo on GitHub" else clip(k.repo.desc, 90), count: ""}
  | none => Headline{value: "0", label: "rising repos", detail: "", count: ""}

fn render(cx: Ctx, g: Got[State]) -> Unit ! fs, log
  pre g.value.repos.all(valid)
= do
  s = g.value
  updated = pulse.day_time(s.updated)
  ks = ranking(s)
  shown = ks.take(30)
  real = ks.any(k => not k.est)
  langs = shown.map(_.repo.lang).filter(_ != "Other").counts.sort_by(p => -p.1).take(6).map(_.0)
  top = shown.first.get
  maxv = top.vel
  gained = shown.filter(k => not k.est).map(_.gained).sum
  stars_ok_all = shown.all(k => stars_ok(k.repo.stars))
  charts = [gain_group(ks)] + (if real and s.snaps.len >= 2 then [curve_group(s, ks)] else [])
  stats = "<div class='stats'>{pulse.stat("+" + compact(top.vel), "stars a day, {esc(short(top.repo.name))}", "")}{pulse.stat(thousands(s.repos.len), "new repos tracked", "{s.repos.len}")}{pulse.stat(if real then "+" + compact(gained.to_f64) else "{s.snaps.len}", if real then "stars gained by the top 30 since the last snapshot" else "snapshots so far", "")}{pulse.stat(langs.first.or("Other"), "most common language in the top 30", "")}</div>"
  chips = pulse.chips("lang", "Filter by language", "#rlist", [("all", "All")] + langs.map(l => (slug(l), l)) + [("other", "Other")])
  sorter = pulse.sort_seg("#rlist", "Sort repos", [("vel", "Fastest"), ("stars", "Most stars"), ("new", "Newest")], "vel")
  list = "<div class='card'><div class='sh'><h2>The top 30</h2>{sorter}</div>{chips}<ol class='rows' id='rlist' style='margin-top:10px'>{shown.enumerate.map(p => row(s, p.0, p.1, maxv, langs, cx.now)).join("")}<li class='empty muted' hidden>No repos in this language today.</li></ol></div>"
  sub = if real then "Stars gained since the previous snapshot, scaled to a day." else "Until a second snapshot exists, this is stars divided by age in days."
  chartrow = "<div class='grid2'>{pulse.chart_block(charts[0], "Who is gaining fastest", sub)}{if charts.len > 1 then pulse.chart_block(charts[1], "Star curves of the leaders", "Stars at each 6 hour snapshot.") else "<div class='card'><h2 class='ct'>Star curves arrive soon</h2><p class='muted' style='margin-top:8px'>Pulse keeps its own snapshots every 6 hours. Once two exist, the leaders' curves appear here, with true stars per day instead of estimates.</p></div>"}</div>"
  body = "<section class='wrap band'>{stats}</section><section class='wrap band'>{chartrow}</section><section class='wrap band'>{list}</section><section class='wrap band'>{pulse.links_row([("data", "../api/repos.json", "JSON for developers")])}</section>"
  h = headline(ks)
  p = Page{title: "Fastest rising GitHub repos", desc: "The new GitHub repositories gaining stars fastest right now. Leader: {top.repo.name}. Computed by SSPUR from its own snapshots.", h1: "<em>{esc(short(top.repo.name))}</em> is rising fastest", lede: "It is gaining about {vel_label(top)} stars a day{if top.est then " (estimated from its age so far)" else ""}. {if stars_ok_all then "These are repos created in the last 30 days, ranked by how fast they gain stars." else ""}", body, updated, stale: g.stale, note: g.note, snippet: pulse.snippet(cx, "rank"), data: pulse.charts_json(charts)}
  pulse.publish(cx, "repos/index.html", pulse.page(cx, p))
  pulse.publish(cx, "api/repos.json", json.encode(Api{meta: pulse.meta(cx, updated, g.stale, h), rising: shown, snapshots: s.snaps.len}))
  pulse.publish(cx, "og/repos.svg", pulse.og_svg(cx, "Fastest rising repos", "+{compact(top.vel)}/day", top.repo.name))

fn main() -> Unit ! log, fs, proc, env, time
= do
  cx = pulse.ctx("repos")
  token = env_var("GITHUB_TOKEN").or("")
  prev = load(cx)
  fresh = if pulse.due(cx, prev.map(_.updated).or(""), 120) then fetch(cx, prev, token) else err("skip")
  match pulse.settle(fresh, prev, () => fetch(pulse.seed_ctx(cx), none, ""))
  | none => log("repos: no data at all")
  | some(g) => do
    if not g.stale then pulse.save(pulse.state_path(cx, "state.json"), json.encode(g.value))
    render(cx, g)
    log("repos: {g.value.repos.len} repos, {g.value.snaps.len} snapshots{if g.stale then " (stale)" else ""}")

// Tests run on the bundled fixtures, offline.

fn fixture(name: Str) -> Str ! fs
= pulse.read("../fixtures/repos/{name}").or("")

fn mk(name: Str, stars: Int, created: Str) -> Repo
= Repo{name, url: "https://github.com/{name}", desc: "", lang: "Rust", stars, forks: 0, created}

test parses_search = parse(fixture("week.json")) is ok(rs) and rs.len >= 10 and rs.all(valid)
test rejects_garbage = parse("<html>rate limited</html>").is_err and parse("\{\"items\": [\{\"full_name\": \"x\"}]}").is_err
test velocity_from_snapshots = rank(mk("a/b", 1300, "2026-10-01T00:00:00Z"), pulse.day_time("2026-10-10T12:00:00Z"), some(Snap{t: "2026-10-10T00:00:00Z", stars: empty_map().put("a/b", 1000)})) == Rank{repo: mk("a/b", 1300, "2026-10-01T00:00:00Z"), vel: 600.0, est: false, gained: 300}
test velocity_estimate = rank(mk("a/b", 1000, "2026-10-08T00:00:00Z"), pulse.day_time("2026-10-10T00:00:00Z"), none).vel == 500.0 and rank(mk("a/b", 1000, "2026-10-08T00:00:00Z"), pulse.day_time("2026-10-10T00:00:00Z"), none).est
test previous_snapshot_skips_recent = prev_snap([Snap{t: "2026-10-10T00:00:00Z", stars: empty_map()}, Snap{t: "2026-10-10T11:00:00Z", stars: empty_map()}], pulse.day_time("2026-10-10T12:00:00Z")).map(_.t) == some("2026-10-10T00:00:00Z")
fn capped(snaps: List[Snap]) -> Bool
= snaps.len == 120 and snaps.last.map(_.t) == some("now") and snaps.all(s => not s.stars.has("gone/z"))

test snapshots_capped = capped(add_snap((0..130).map(i => Snap{t: "t{i}", stars: empty_map().put("x/y", i).put("gone/z", 1)}), "now", [mk("x/y", 5, "2026-10-01T00:00:00Z")], ["x/y"]))
test ranking_orders_by_velocity = ranking(State{updated: "2026-10-10T00:00:00Z", repos: [mk("slow/a", 100, "2026-10-01T00:00:00Z"), mk("fast/b", 900, "2026-10-08T00:00:00Z")], snaps: []}).map(_.repo.name) == ["fast/b", "slow/a"]
