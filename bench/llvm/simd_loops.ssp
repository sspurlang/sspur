type Acc = {s1: Int, s2: Int, s3: Int, s4: Int, d: F64, y: F64}

fn elem(i: Int) -> Int
= (i * 7919) % 10007 - 5000

fn felem(i: Int, k: Int) -> F64
= ((i * k) % 1009).to_f64 / 128.0 - 3.5

fn affine_pos(n: Int, r: Int) -> Int
= do
  var s = 0
  for i in 0..n
    y = 3 * elem(i) + r
    if y > 0 then s := s + y
  s

fn sq_sum(n: Int, r: Int) -> Int
= do
  var s = 0
  for i in 0..n
    x = elem(i)
    s := s + (x + r) * (x - r)
  s

fn count_over(n: Int, t: Int) -> Int
= do
  var c = 0
  for i in 0..n
    if elem(i) > t then c := c + 1
  c

fn shifted_sum(n: Int, r: Int) -> Int
= do
  var s = 0
  for i in 0..n
    s := s + (elem(i) * 5 - r)
  s

fn dot(n: Int) -> F64
= do
  var s = -0.0
  for i in 0..n
    s := s + felem(i, 31) * felem(i, 17)
  s

fn saxpy_sum(k: F64, n: Int) -> F64
= do
  var s = -0.0
  for i in 0..n
    s := s + (k * felem(i, 31) + felem(i, 17))
  s

fn round_of(a: Acc, r: Int, n: Int) -> Acc
= a with s1 := a.s1 + affine_pos(n, r), s2 := a.s2 + sq_sum(n, r), s3 := a.s3 + count_over(n, r * 50 - 1000), s4 := a.s4 + shifted_sum(n, r), d := a.d + dot(n), y := a.y + saxpy_sum(r.to_f64 * 0.25, n)

fn main() -> Unit ! log
= do
  var a = Acc{s1: 0, s2: 0, s3: 0, s4: 0, d: 0.0, y: 0.0}
  for r in 0..40
    a := round_of(a, r, 1000000)
  log("affine {a.s1} squares {a.s2} count {a.s3} shifted {a.s4}")
  log("dot {(a.d * 1000.0).checked_round.or(0)} saxpy {(a.y * 1000.0).checked_round.or(0)}")
