{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utkarshavardhana.github.io/sspur-packages/schema/package.schema.json",
  "title": "An SSPUR package in the index (schema 1)",
  "description": "packages/<first two letters of the name>/<name>.json. Versions are only appended; after publishing, only yanked and deprecated may change.",
  "type": "object",
  "required": ["schema", "name", "repository", "owners", "versions"],
  "properties": {
    "schema": {"const": 1},
    "name": {"type": "string", "pattern": "^(?!.*_$)[a-z](?:[a-z0-9]|_(?!_)){1,39}$", "description": "Lowercase letters, digits and single underscores, not ending in one"},
    "description": {"type": "string", "maxLength": 200},
    "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "GitHub logins that may publish, yank and deprecate"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "versions": {"type": "array", "items": {"$ref": "#/$defs/version"}}
  },
  "$defs": {
    "version": {
      "type": "object",
      "required": ["version", "git", "tag", "commit", "hash", "effects", "deps", "license", "yanked", "published", "publisher", "api"],
      "properties": {
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "git": {"type": "string", "description": "The repository to clone when the snapshot is missing"},
        "tag": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "hash": {"type": "string", "description": "The export hash: the Merkle root over the hashes of the public definitions (ADR 0026)"},
        "snapshot": {
          "type": ["object", "null"],
          "required": ["url", "sha256"],
          "properties": {
            "url": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "size": {"type": "integer", "minimum": 0}
          }
        },
        "effects": {"type": "array", "items": {"type": "string"}, "description": "Capability effects of the public functions"},
        "deps": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Package name to version requirement"},
        "license": {"type": "string", "description": "An SPDX expression of OSI-approved licences"},
        "yanked": {"type": "boolean"},
        "deprecated": {"type": ["string", "null"]},
        "published": {"type": "string", "format": "date-time"},
        "publisher": {"type": "string"},
        "request": {"type": ["integer", "null"], "description": "The request issue"},
        "api": {"type": "array", "items": {"$ref": "#/$defs/item"}}
      }
    },
    "item": {
      "type": "object",
      "required": ["name", "kind", "sig"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["fn", "extern", "type", "effect", "trait", "impl"]},
        "sig": {"type": "string"},
        "sig_hash": {"type": "string"},
        "hash": {"type": "string"},
        "effects": {"type": "array", "items": {"type": "string"}},
        "doc": {"type": "string"}
      }
    }
  }
}
