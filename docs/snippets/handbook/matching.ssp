type Shape = Circle{r: F64} | Rect{w: F64, h: F64} | Dot

// ANCHOR: guards
fn label(s: Shape) -> Str
= match s
  | Circle{r} if r > 10.0 => "big circle"
  | Circle => "circle"
  | Rect{w, h} if w == h => "square"
  | Rect{w: width} => "rect {width} wide"
  | Dot => "dot"
// ANCHOR_END: guards

// ANCHOR: values
fn fizz(n: Int) -> Str
= match (n % 3, n % 5)
  | (0, 0) => "FizzBuzz"
  | (0, _) => "Fizz"
  | (_, 0) => "Buzz"
  | _ => n.str

fn parse_port(s: Str) -> Str
= match s.to_int
  | some(p) if p > 0 and p < 65536 => "port {p}"
  | some(p) => "{p} is out of range"
  | none => "not a number"
// ANCHOR_END: values

// ANCHOR: or
fn corners(s: Shape) -> Int
= match s
  | Circle | Dot => 0
  | Rect => 4

fn weekend(day: Str) -> Bool
= match day.lower
  | "sat" | "sun" => true
  | _ => false
// ANCHOR_END: or

// ANCHOR: lists
fn total(xs: List[Int]) -> Int
= match xs
  | [] => 0
  | [x, ..rest] => x + total(rest)

fn describe(xs: List[Str]) -> Str
= match xs
  | [] => "nothing"
  | [one] => one
  | [first, .., last] => "{first} to {last}"

fn route(parts: List[Str]) -> Str
= match parts
  | ["users", id] => "user {id}"
  | ["users", id, "posts", ..rest] => "{rest.len} posts of {id}"
  | [_, ..] | [] => "not found"
// ANCHOR_END: lists

// ANCHOR: is
fn port_or(s: Str, d: Int) -> Int
= if s.to_int is some(p) and p > 0 then p else d

fn radius(s: Shape) -> F64
= if s is Circle{r} then r else 0.0
// ANCHOR_END: is

// ANCHOR: tests
fn circles(shapes: List[Shape]) -> Int
= shapes.filter(_ is Circle).len

fn has_pair(xs: List[Int]) -> Bool
= xs is [_, _, ..]

fn both_round(a: Shape, b: Shape) -> F64
= if a is Circle{r} and b is Circle{r: r2} then r + r2 else 0.0
// ANCHOR_END: tests

// ANCHOR: guard
type ArgErr = Missing{name: Str}

fn first_port(args: List[Str]) -> Int
= do
  [first, ..] = args else 80
  some(p) = first.to_int else 80
  p

fn need(opts: Map[Str, Str], name: Str) -> Str ! fail[ArgErr]
= do
  some(v) = opts.get(name) else raise Missing{name}
  v.trim
// ANCHOR_END: guard

// ANCHOR: rule
type Zone = Local | Remote

rule fee(kg: Int, zone: Zone, prime: Bool) -> Int
  | kg <= 1, _, true => 0
  | kg <= 5, Local, _ => 5
  | _, Remote, _ => 12
  | _, _, _ => 8
// ANCHOR_END: rule

test labels = label(Circle{r: 20.0}) == "big circle" and label(Rect{w: 2.0, h: 2.0}) == "square" and label(Rect{w: 3.0, h: 1.0}) == "rect 3.0 wide"
test fizzbuzz = (1..16).map(fizz).take(5) == ["1", "2", "Fizz", "4", "Buzz"] and fizz(15) == "FizzBuzz"
test ports = parse_port("8080") == "port 8080" and parse_port("0") == "0 is out of range" and parse_port("x") == "not a number"
test fees = fee(1, Remote, true) == 0 and fee(3, Local, false) == 5 and fee(9, Local, true) == 8
test or_patterns = corners(Dot) == 0 and corners(Rect{w: 1.0, h: 2.0}) == 4 and weekend("Sun") and not weekend("mon")
test lists = total([1, 2, 3]) == 6 and describe(["a", "b", "c"]) == "a to c" and describe(["x"]) == "x" and route(["users", "7"]) == "user 7" and route(["users", "7", "posts", "1", "2"]) == "2 posts of 7" and route([]) == "not found"
test is_tests = port_or("8080", 80) == 8080 and port_or("-1", 80) == 80 and radius(Circle{r: 2.0}) == 2.0 and radius(Dot) == 0.0
test is_exprs = circles([Circle{r: 1.0}, Dot, Circle{r: 2.0}]) == 2 and has_pair([1, 2]) and not has_pair([1]) and both_round(Circle{r: 1.0}, Circle{r: 2.0}) == 3.0 and both_round(Dot, Circle{r: 2.0}) == 0.0
test guards = first_port(["8080", "x"]) == 8080 and first_port([]) == 80 and first_port(["x"]) == 80 and need(empty_map().put("port", " 80 "), "port") == "80"
